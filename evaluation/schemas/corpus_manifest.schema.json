{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CorpusManifest",
  "type": "object",
  "required": ["version", "updated_at", "source", "documents"],
  "properties": {
    "version": { "type": "string" },
    "updated_at": { "type": "string" },
    "source": { "type": "string" },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["document_id", "file_path", "corpus_class", "document_type_expected", "source_status", "curation_status"],
        "properties": {
          "document_id": { "type": "string" },
          "file_path": { "type": "string" },
          "corpus_class": {
            "type": "string",
            "enum": [
              "golden_candidate_raw_lab",
              "derived_output_do_not_use_as_source",
              "negative_document",
              "excluded_document",
              "shadow_document"
            ]
          },
          "document_type_expected": { "type": "string" },
          "source_status": { "type": "string" },
          "curation_status": { "type": "string" },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
